PORT=3000
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=skillswap
# DB_SSL=true — обязательно для Supabase, не нужно для локального Postgres
DB_SSL=false
# DB_SYNC=true — только для локальной БД. Для общей Supabase-БД — ВСЕГДА false,
# иначе синхронизация схемы у одного человека может сломать её всем.
DB_SYNC=true

JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=3600
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRES_IN=604800

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# =====================
# MAIL (SMTP)
# =====================
MAIL_HOST=smtp.example.com
# 465 = SSL (secure=true), 587 = STARTTLS (secure=false)
MAIL_PORT=465
# optional: если не указан — определяется по порту (465 => true)
MAIL_SECURE=true
MAIL_USER=your_email@example.com
MAIL_PASSWORD=your_app_password
MAIL_FROM="No Reply" <noreply@example.com>

# retry логика
MAIL_MAX_RETRIES=3
MAIL_RETRY_DELAY_MS=1000
