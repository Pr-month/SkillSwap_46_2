PORT=3000
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=skillswap
# DB_SSL=true — обязательно для Supabase, не нужно для локального Postgres
DB_SSL=false
# DB_SYNC=true — только для локальной БД. Для общей Supabase-БД — ВСЕГДА false,
# иначе синхронизация схемы у одного человека может сломать её всем.
DB_SYNC=true

JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=3600
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRES_IN=604800

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
